# Copy this file to .env and fill in your own key.
# .env is gitignored - never commit your real key.

# Get a free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model id. Check the current free-tier model name in AI Studio, as these
# change over time. Examples that have been used: gemini-flash-latest,
# gemini-2.0-flash, gemini-3.1-flash-lite
GEMINI_MODEL=gemini-flash-latest
